{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "studia/scheda.schema.json",
  "title": "Scheda di analisi di un materiale",
  "type": "object",
  "additionalProperties": false,
  "required": ["sintesi", "temi"],
  "properties": {
    "sintesi": { "type": "string", "minLength": 20, "maxLength": 1500 },
    "disciplina": { "type": "string", "maxLength": 120 },
    "livello": { "type": "string", "enum": ["teorico", "applicativo", "strumentale", "normativo", "misto"] },
    "temi": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["titolo"],
        "properties": {
          "titolo": { "type": "string", "minLength": 3, "maxLength": 140 },
          "sintesi": { "type": "string", "maxLength": 600 },
          "da": { "type": "integer", "minimum": 0 },
          "a": { "type": "integer", "minimum": 0 },
          "pagine": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "concetti": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 80 } },
    "prerequisiti": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 140 } },
    "collegamenti": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 200 } },
    "capitoliProposti": {
      "type": "array", "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["titolo"],
        "properties": {
          "titolo": { "type": "string", "minLength": 3, "maxLength": 140 },
          "outline": { "type": "string", "maxLength": 1000 },
          "da": { "type": "integer", "minimum": 0 },
          "a": { "type": "integer", "minimum": 0 },
          "pagine": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "note": { "type": "string", "maxLength": 800 }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Presentazione locale di ZAINO",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "zainoId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 640,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 360,
          "maximum": 2160
        },
        "theme": {
          "enum": [
            "zaino-light",
            "zaino-dark"
          ]
        },
        "navigationMode": {
          "enum": [
            "default",
            "grid"
          ]
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "fontFamily": {
          "enum": [
            "zaino",
            "arial",
            "verdana",
            "georgia",
            "courier",
            "atkinson",
            "testme",
            "atkinson-next",
            "testme-alt"
          ]
        }
      },
      "required": [
        "width",
        "height",
        "theme",
        "navigationMode",
        "reducedMotion"
      ]
    },
    "assets": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,100}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "image",
              "audio",
              "video"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^assets/[a-f0-9]{64}\\.[a-z0-9]{2,5}$"
          },
          "mimeType": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif",
              "audio/mpeg",
              "audio/wav",
              "audio/ogg",
              "audio/flac",
              "audio/mp4",
              "audio/aac",
              "audio/aiff",
              "video/mp4",
              "video/webm",
              "video/quicktime",
              "video/x-matroska",
              "video/x-msvideo",
              "video/mpeg"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "keyword",
                  "album",
                  "audio",
                  "video"
                ]
              },
              "id": {
                "type": "string",
                "maxLength": 500
              },
              "title": {
                "type": "string",
                "maxLength": 500
              },
              "link": {
                "type": "string",
                "maxLength": 2000
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            },
            "required": [
              "kind",
              "id"
            ]
          }
        },
        "required": [
          "kind",
          "path",
          "mimeType",
          "sha256",
          "size"
        ]
      }
    },
    "stacks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "slides": {
            "type": "array",
            "minItems": 1,
            "maxItems": 300,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,100}$"
                },
                "title": {
                  "type": "string",
                  "maxLength": 140
                },
                "layout": {
                  "enum": [
                    "free",
                    "title-text",
                    "text-image",
                    "image-caption",
                    "two-columns",
                    "formula-text",
                    "media"
                  ]
                },
                "autoAnimate": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "groupId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{1,100}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 5
                    }
                  },
                  "required": [
                    "enabled",
                    "groupId",
                    "duration"
                  ]
                },
                "blocks": {
                  "type": "array",
                  "maxItems": 200,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,100}$"
                      },
                      "type": {
                        "enum": [
                          "title",
                          "text",
                          "list",
                          "math",
                          "image",
                          "audio",
                          "video",
                          "shape",
                          "table",
                          "navbar",
                          "page-number",
                          "drawing"
                        ]
                      },
                      "slot": {
                        "enum": [
                          "title",
                          "body",
                          "media",
                          "formula",
                          "left",
                          "right",
                          "caption"
                        ]
                      },
                      "markdown": {
                        "type": "string",
                        "maxLength": 100000
                      },
                      "latex": {
                        "type": "string",
                        "maxLength": 20000
                      },
                      "display": {
                        "type": "boolean"
                      },
                      "assetId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,100}$"
                      },
                      "alt": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "caption": {
                        "type": "string",
                        "maxLength": 10000
                      },
                      "items": {
                        "type": "array",
                        "maxItems": 200,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]{1,100}$"
                            },
                            "markdown": {
                              "type": "string",
                              "maxLength": 20000
                            },
                            "richText": {
                              "$ref": "#/$defs/richText"
                            }
                          },
                          "required": [
                            "id",
                            "markdown"
                          ]
                        }
                      },
                      "style": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "column": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 12
                          },
                          "span": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 12
                          },
                          "row": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 12
                          },
                          "rowSpan": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 12
                          },
                          "fontSize": {
                            "type": "number",
                            "minimum": 12,
                            "maximum": 160
                          },
                          "color": {
                            "type": "string",
                            "pattern": "^#[a-fA-F0-9]{6}$"
                          },
                          "align": {
                            "enum": [
                              "left",
                              "center",
                              "right"
                            ]
                          },
                          "scale": {
                            "type": "number",
                            "minimum": 0.25,
                            "maximum": 4
                          },
                          "highlight": {
                            "type": "string",
                            "pattern": "^#[a-fA-F0-9]{6}$"
                          },
                          "box": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "x": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                              },
                              "y": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                              },
                              "width": {
                                "type": "number",
                                "minimum": 2,
                                "maximum": 100
                              },
                              "height": {
                                "type": "number",
                                "minimum": 2,
                                "maximum": 100
                              }
                            },
                            "required": [
                              "x",
                              "y",
                              "width",
                              "height"
                            ]
                          },
                          "verticalAlign": {
                            "enum": [
                              "start",
                              "center",
                              "end"
                            ]
                          },
                          "fontFamily": {
                            "enum": [
                              "zaino",
                              "arial",
                              "verdana",
                              "georgia",
                              "courier",
                              "atkinson",
                              "testme",
                              "atkinson-next",
                              "testme-alt"
                            ]
                          },
                          "bold": {
                            "type": "boolean"
                          },
                          "italic": {
                            "type": "boolean"
                          },
                          "underline": {
                            "type": "boolean"
                          },
                          "lineHeight": {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 2
                          },
                          "fontWeight": {
                            "type": "integer",
                            "enum": [
                              200,
                              300,
                              400,
                              500,
                              600,
                              700,
                              800,
                              900
                            ]
                          },
                          "appearance": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "opacity": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              "blend": {
                                "enum": [
                                  "normal",
                                  "multiply",
                                  "screen",
                                  "overlay",
                                  "darken",
                                  "lighten"
                                ]
                              },
                              "grayscale": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                              },
                              "sepia": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                              },
                              "brightness": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 200
                              },
                              "contrast": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 200
                              },
                              "saturate": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 200
                              },
                              "blur": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 20
                              }
                            }
                          }
                        },
                        "required": []
                      },
                      "matchId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,100}$"
                      },
                      "source": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "enum": [
                              "keyword",
                              "album",
                              "audio",
                              "video"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "maxLength": 500
                          },
                          "title": {
                            "type": "string",
                            "maxLength": 500
                          },
                          "link": {
                            "type": "string",
                            "maxLength": 2000
                          },
                          "page": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100000
                          }
                        },
                        "required": [
                          "kind",
                          "id"
                        ]
                      },
                      "autoplay": {
                        "type": "boolean"
                      },
                      "start": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 604800
                      },
                      "end": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 604800
                      },
                      "crop": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "x": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          },
                          "y": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          },
                          "width": {
                            "type": "number",
                            "minimum": 2,
                            "maximum": 100
                          },
                          "height": {
                            "type": "number",
                            "minimum": 2,
                            "maximum": 100
                          },
                          "aspect": {
                            "type": "number",
                            "minimum": 0.01,
                            "maximum": 100
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "width",
                          "height",
                          "aspect"
                        ]
                      },
                      "richText": {
                        "$ref": "#/$defs/richText"
                      },
                      "shape": {
                        "enum": [
                          "rectangle",
                          "ellipse",
                          "arrow"
                        ]
                      },
                      "table": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 20,
                        "items": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 10,
                          "items": {
                            "type": "string",
                            "maxLength": 2000
                          }
                        }
                      },
                      "hidden": {
                        "type": "boolean"
                      },
                      "variant": {
                        "enum": [
                          "steps",
                          "tabs",
                          "progress"
                        ]
                      },
                      "scope": {
                        "enum": [
                          "main",
                          "all"
                        ]
                      },
                      "drawing": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "viewBox": {
                            "type": "string",
                            "maxLength": 200
                          },
                          "nodes": {
                            "type": "array",
                            "maxItems": 15000,
                            "items": {
                              "$ref": "#/$defs/vectorNode"
                            }
                          },
                          "scene": {
                            "type": "array",
                            "maxItems": 2000,
                            "items": {
                              "type": "object"
                            }
                          }
                        },
                        "required": [
                          "viewBox",
                          "nodes",
                          "scene"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "type",
                      "slot"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "enum": [
                                "title",
                                "text"
                              ]
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "markdown"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "math"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "latex",
                            "display"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "list"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "items"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "enum": [
                                "image",
                                "audio",
                                "video"
                              ]
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "assetId"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "shape"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "shape"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "table"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "table"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "navbar"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "variant",
                            "scope"
                          ]
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "type": {
                              "const": "drawing"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "drawing"
                          ]
                        }
                      }
                    ]
                  }
                },
                "animations": {
                  "type": "array",
                  "maxItems": 2000,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "targetId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,100}$"
                      },
                      "step": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "effect": {
                        "enum": [
                          "fade-in",
                          "fade-up",
                          "slide-left",
                          "zoom-in",
                          "fade-out",
                          "grow",
                          "shrink",
                          "highlight-red",
                          "pulse",
                          "words",
                          "lines",
                          "list-items",
                          "table-rows",
                          "draw",
                          "underline",
                          "path-line",
                          "path-arc",
                          "path-orbit",
                          "fade-down",
                          "slide-right",
                          "bounce-in",
                          "rotate-in",
                          "wipe-in",
                          "unfold-in",
                          "slide-out-left",
                          "slide-out-right",
                          "slide-out-up",
                          "slide-out-down",
                          "zoom-out",
                          "shake",
                          "wobble",
                          "spin",
                          "letters",
                          "table-columns",
                          "path-wave",
                          "path-zigzag"
                        ]
                      },
                      "start": {
                        "enum": [
                          "click",
                          "with",
                          "after"
                        ]
                      },
                      "duration": {
                        "type": "number",
                        "minimum": 0.1,
                        "maximum": 20
                      },
                      "delay": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20
                      },
                      "distance": {
                        "type": "number",
                        "minimum": 10,
                        "maximum": 300
                      }
                    },
                    "required": [
                      "targetId",
                      "step",
                      "effect"
                    ]
                  }
                },
                "notes": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "markdown": {
                      "type": "string",
                      "maxLength": 100000
                    }
                  },
                  "required": [
                    "markdown"
                  ]
                },
                "background": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "backgroundMedia": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "assetId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,100}$"
                    },
                    "fit": {
                      "enum": [
                        "cover",
                        "contain"
                      ]
                    },
                    "loop": {
                      "type": "boolean"
                    },
                    "muted": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "assetId",
                    "fit"
                  ]
                }
              },
              "required": [
                "id",
                "title",
                "layout",
                "autoAnimate",
                "blocks",
                "animations",
                "notes"
              ]
            }
          }
        },
        "required": [
          "id",
          "slides"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "zainoId",
    "title",
    "revision",
    "settings",
    "assets",
    "stacks"
  ],
  "$defs": {
    "richText": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 100000
              },
              "style": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "fontSize": {
                    "type": "number",
                    "minimum": 12,
                    "maximum": 160
                  },
                  "color": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^#[a-fA-F0-9]{6}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "fontFamily": {
                    "enum": [
                      "zaino",
                      "arial",
                      "verdana",
                      "georgia",
                      "courier",
                      "atkinson",
                      "testme",
                      "atkinson-next",
                      "testme-alt"
                    ]
                  },
                  "bold": {
                    "type": "boolean"
                  },
                  "italic": {
                    "type": "boolean"
                  },
                  "underline": {
                    "type": "boolean"
                  },
                  "fontWeight": {
                    "type": "integer",
                    "enum": [
                      200,
                      300,
                      400,
                      500,
                      600,
                      700,
                      800,
                      900
                    ]
                  }
                }
              },
              "link": {
                "type": "string",
                "maxLength": 2000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "latex",
              "display"
            ],
            "properties": {
              "latex": {
                "type": "string",
                "maxLength": 20000
              },
              "display": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "markdown"
            ],
            "properties": {
              "markdown": {
                "type": "string",
                "maxLength": 100000
              }
            }
          }
        ]
      }
    },
    "vectorNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "enum": [
            "g",
            "path",
            "rect",
            "ellipse",
            "circle",
            "line",
            "polyline",
            "polygon",
            "text",
            "tspan",
            "defs",
            "clipPath",
            "mask",
            "pattern"
          ]
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 500000
          }
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "children": {
          "type": "array",
          "maxItems": 15000,
          "items": {
            "$ref": "#/$defs/vectorNode"
          }
        }
      },
      "required": [
        "tag",
        "attrs",
        "children"
      ]
    }
  }
}

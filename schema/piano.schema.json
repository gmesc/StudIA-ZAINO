{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "studia/piano.schema.json",
  "title": "Piano di un corso (_piano.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "course",
    "lezioni"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "course": {
      "type": "string",
      "minLength": 1
    },
    "wizardStep": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "status": {
      "type": "string",
      "enum": [
        "raccolta",
        "ingest",
        "proposto",
        "approvato",
        "in-generazione",
        "generato",
        "errore"
      ]
    },
    "granularity": {
      "type": "string",
      "enum": [
        "atomico",
        "medio",
        "ampio"
      ]
    },
    "origine": {
      "type": "string",
      "enum": [
        "euristica",
        "ai",
        "multiagente",
        "manuale"
      ]
    },
    "aggiornato": {
      "type": "string"
    },
    "brief": {
      "type": "object"
    },
    "costPreview": {
      "type": "object"
    },
    "lezioni": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "folder",
          "title",
          "materiali"
        ],
        "properties": {
          "folder": {
            "type": "string",
            "pattern": "^[0-9]{2}-[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "area": {
            "type": "string",
            "maxLength": 80
          },
          "rationale": {
            "type": "string",
            "maxLength": 600
          },
          "status": {
            "type": "string",
            "enum": [
              "proposto",
              "approvato",
              "generato",
              "parziale",
              "errore"
            ]
          },
          "materiali": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "video",
                    "pdf"
                  ]
                },
                "num": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "titolo": {
                  "type": "string"
                },
                "durata": {
                  "type": "integer",
                  "minimum": 0
                },
                "pagine": {
                  "type": "integer",
                  "minimum": 0
                },
                "pages": {
                  "type": "string"
                }
              }
            }
          },
          "capitoli": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "title"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^[0-9]{2}-[a-z0-9-]+\\.md$"
                },
                "title": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 120
                },
                "outline": {
                  "type": "string",
                  "maxLength": 1200
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "proposto",
                    "generato",
                    "errore"
                  ]
                },
                "fonte": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "video",
                        "pdf"
                      ]
                    },
                    "materiale": {
                      "type": "string"
                    },
                    "from": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "to": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "pages": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "tipo": {
            "type": "string",
            "enum": [
              "lezione",
              "modulo-fonte"
            ]
          }
        }
      }
    },
    "rimandi": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "da",
          "a"
        ],
        "properties": {
          "da": {
            "type": "string"
          },
          "a": {
            "type": "string"
          },
          "perche": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "decisioni": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 600
      }
    }
  }
}

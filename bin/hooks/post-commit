#!/bin/bash
# Dopo ogni commit che tocca il SITO — presentazione, guida dell'app, suoi screenshot, generatore —
# la ricetta parte da sola: `node bin/sito.js` scrive in dist/sito/, che è LA FONTE DI VERITÀ del
# sito (deciso il 7 settembre 2026). Se esiste ~/Claude/insegnai.ch/studia-zaino, ne riceve una
# copia identica: è uno specchio, non l'originale. Così i file da caricare sono sempre quelli
# dell'ultimo commit, senza che nessuno debba ricordarsi di rifarli.
#
# Si attiva UNA volta per copia del repo (git non versiona gli hook, questa cartella sì):
#     git config core.hooksPath bin/hooks
#
# Un post-commit non può fermare il commit, e non deve: se qualcosa va storto lo dice e basta.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 0
TOCCATI="$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null)"
# SITO_FORZA=1 la lancia comunque: per rifare il sito a mano, senza un commit.
[ -n "${SITO_FORZA:-}" ] || printf '%s\n' "$TOCCATI" | grep -qE '^(sito/|App/guida-zaino/|bin/sito\.js$|App/assets/1F392\.svg$|App/assets/fonts/)' || exit 0
command -v node >/dev/null 2>&1 || { echo "  sito: manca node, ricetta non lanciata"; exit 0; }
node bin/sito.js || { echo "  ✗ sito: la ricetta è fallita (vedi sopra) — il commit resta"; exit 0; }
SPECCHIO="$HOME/Claude/insegnai.ch/studia-zaino"
if [ -d "$SPECCHIO" ]; then
  rsync -a --delete --exclude .DS_Store dist/sito/ "$SPECCHIO/" && echo "  sito: copia rispecchiata in $SPECCHIO"
fi

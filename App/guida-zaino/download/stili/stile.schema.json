{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stile ZAINO · versione 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formato": {
      "const": "zaino-stile"
    },
    "versione": {
      "const": 1
    },
    "tipo": {
      "enum": [
        "mappa",
        "slide",
        "navbar"
      ]
    },
    "nome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "\\S"
    },
    "autore": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "licenza": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "stile": {
      "type": "object"
    }
  },
  "required": [
    "formato",
    "versione",
    "tipo",
    "nome",
    "stile"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "mappa"
          }
        }
      },
      "then": {
        "properties": {
          "stile": {
            "$ref": "#/definitions/mappa"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "slide"
          }
        }
      },
      "then": {
        "properties": {
          "stile": {
            "$ref": "#/definitions/slide"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "navbar"
          }
        }
      },
      "then": {
        "properties": {
          "stile": {
            "$ref": "#/definitions/navbar"
          }
        }
      }
    }
  ],
